# ── Claude API (콘텐츠 생성) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Instagram Graph API (공식 API 업로드) ────────────────
# 준비물: Instagram 프로페셔널(비즈니스/크리에이터) 계정 + Facebook 페이지 연결
#         + Meta 개발자 앱에서 발급한 장기 액세스 토큰
# IG_USER_ID: Instagram Business Account ID (숫자)
IG_ACCESS_TOKEN=
IG_USER_ID=

# ── 이미지 공개 URL 베이스 ───────────────────────────────
# Instagram API는 "공개적으로 접근 가능한 이미지 URL"만 받으므로,
# drafts/ 를 GitHub에 push한 뒤 raw URL 또는 GitHub Pages URL을 사용
# 예: https://raw.githubusercontent.com/<owner>/<repo>/<branch>/social-automation
IMAGE_BASE_URL=
