# ── 서버 보안 ───────────────────────────────────────────
WEBHOOK_SECRET=긴-무작위-문자열      # 설문폼 웹훅 호출 시 ?secret= 로 전달 (Apps Script 의 WEBHOOK_SECRET 과 동일하게)
ADMIN_PASSWORD=대시보드-비밀번호

# ── 발송사 선택: console(실발송 없음) | solapi | aligo ─────
ALIMTALK_PROVIDER=console
ALIMTALK_SENDER=0212345678          # 발송사에 사전 등록한 발신번호 (숫자만)
# ALIMTALK_DRY_RUN=1                # 1 이면 어떤 발송사 설정이든 실발송 없이 로그만 남김

# ── 솔라피(SOLAPI) ─────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=                       # 솔라피 콘솔 > 카카오 채널 연동 후 발급되는 pfId (KA01PF...)

# ── 알리고(aligo) ──────────────────────────────────────
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER_KEY=                   # 알리고 > 카카오 채널 연동 후 발급되는 발신프로필 키
# ALIGO_TEST_MODE=1                 # 알리고 테스트 모드(과금 없음)

# ── 기타 ───────────────────────────────────────────────
# RULES_PATH=rules.yaml
# DB_PATH=data/alimtalk.db
# WORKER_ENABLED=1
# WORKER_INTERVAL=15
